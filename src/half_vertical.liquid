{% if selected %}
  {{ frame_panel_styles }}
  {{ classic_styles }}
  <div class="layout built-classic built-classic--vertical">
    <img class="built-panel-classic image image--contain image-dither w--full h--full built-classic__art portrait:hidden" src="{{ selected.image_url_standard | escape }}" alt="{{ selected.image_alt | escape }}">
    <img class="built-panel-classic image image--contain image-dither w--full h--full built-classic__art built-classic__portrait-source landscape:hidden" src="{{ selected.image_url_frame_portrait | default: selected.image_url_standard | escape }}" alt="{{ selected.image_alt | escape }}">
    {{ frame_panel_art }}
    <div class="built-classic__label">
      {{ compact_label }}
      <p class="description description--large lg:description--xxlarge hidden lg:block">{{ selected.detail | escape }}</p>
    </div>
  </div>
{% else %}
  {{ empty_exhibit }}
{% endif %}
{{ built_title_bar }}
