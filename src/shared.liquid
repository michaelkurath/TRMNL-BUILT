{% assign selected = selected_entry %}

{% assign display_edition = trmnl.plugin_settings.custom_fields_values.display_edition | default: "auto" %}
{% if selected and display_edition != "classic" and display_edition != "frame" %}
  {% assign frame_visibility = " built-frame--auto" %}
  {% assign classic_visibility = " built-classic--auto" %}
{% endif %}

{% capture frame_exhibit %}
  {% assign frame_landscape = selected.image_url_frame_landscape | default: selected.image_url_wide %}
  {% assign frame_portrait = selected.image_url_frame_portrait | default: selected.image_url_standard %}
  {% assign frame_caption = trmnl.plugin_settings.custom_fields_values.frame_caption %}
  {% assign frame_show_title = trmnl.plugin_settings.custom_fields_values.frame_show_title | append: "" %}
  <style>
    .trmnl .screen:not(.screen--frame) > .view--full:has(> .built-frame:not(.built-frame--auto)) {
      overflow: hidden;
    }
    .trmnl .screen--frame:has(> .view--full > .built-frame),
    .trmnl .screen:has(> .view--full > .built-frame:not(.built-frame--auto)) {
      padding: 0;
    }
    .trmnl .screen--frame > .view--full:has(> .built-frame),
    .trmnl .screen > .view--full:has(> .built-frame:not(.built-frame--auto)) {
      width: var(--screen-w);
      height: var(--screen-h);
      padding: 0;
    }
    .trmnl .layout.built-frame {
      position: relative;
      width: var(--screen-w);
      height: var(--screen-h);
      padding: 0;
      background: #fff;
    }
    .built-frame__art {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    .screen--frame .built-frame__art--colour { object-fit: cover; }
    .trmnl .screen:not(.screen--frame) .layout.built-frame--auto,
    .trmnl .screen--frame .layout.built-classic--auto,
    .trmnl .screen--frame > .view--full > .built-title-bar,
    .built-frame__art--portrait { display: none; }
    .screen--portrait .built-frame__art--landscape { display: none; }
    .screen--portrait .built-frame__art--portrait { display: block; }
    .built-frame__label {
      position: absolute;
      z-index: 1;
      inset-block-start: 2.5cqmin;
      inset-inline-end: 2.5cqmin;
      box-sizing: border-box;
      width: 23cqw;
      padding: 0.75em 0.85em;
      border: 1px solid #181818;
      background: #fff;
      color: #181818;
      font: clamp(12px, 1.05cqw, 28px)/1.3 system-ui, sans-serif;
      overflow-wrap: anywhere;
    }
    .screen--portrait .built-frame__label {
      width: 40cqw;
      font-size: clamp(12px, 1.8cqw, 26px);
    }
    .built-frame__label--title { width: fit-content; max-width: 40cqw; }
    .screen--portrait .built-frame__label--title { width: fit-content; }
    .built-frame__name { margin: 0; font: bold 1.4em/1.1 Georgia, serif; }
    .built-frame__meta { font-size: 0.78em; }
    .built-frame__description { margin: 0.45em 0; }
  </style>
  <div class="layout built-frame{{ frame_visibility }}">
    <img class="image image-dither built-frame__art built-frame__art--landscape{% if selected.image_url_frame_landscape %} built-frame__art--colour{% endif %}"
      loading="lazy" src="{{ frame_landscape | escape }}" alt="{{ selected.image_alt | escape }}">
    <img class="image image-dither built-frame__art built-frame__art--portrait{% if selected.image_url_frame_portrait %} built-frame__art--colour{% endif %}"
      loading="lazy" src="{{ frame_portrait | escape }}" alt="{{ selected.image_alt | escape }}">
    {% if frame_caption == "overlay" %}
      <aside class="built-frame__label">
        <h1 class="built-frame__name">{{ selected.name | escape }}</h1>
        <div class="built-frame__meta">{{ selected.location | escape }} · {{ selected.year }}</div>
        <p class="built-frame__description">{{ selected.caption | escape }}</p>
        <div class="built-frame__meta">Artistic reconstruction</div>
      </aside>
    {% elsif frame_show_title == "true" %}
      <aside class="built-frame__label built-frame__label--title">
        <h1 class="built-frame__name">{{ selected.name | escape }}</h1>
      </aside>
    {% endif %}
  </div>
{% endcapture %}

{% capture classic_styles %}
<style>
  .trmnl .layout.built-classic {
    display: grid;
    padding: 0;
  }
  .trmnl .layout.built-classic--full,
  .trmnl .layout.built-classic--vertical,
  .trmnl .layout.built-classic--quadrant {
    grid-template-rows: minmax(0, 1fr) auto;
  }
  .trmnl .layout.built-classic--horizontal {
    grid-template-columns: minmax(0, 43fr) minmax(0, 57fr);
  }
  .built-classic__art {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
  }
  .built-classic__label {
    padding: 0.45rem 0.65rem;
    color: #171717;
  }
  .built-classic__meta {
    font: 600 clamp(10px, 1.9cqmin, 24px)/1.15 system-ui, sans-serif;
  }
  .built-classic__name {
    margin: 0.15em 0;
    font: bold clamp(19px, 5.3cqmin, 64px)/1.02 Georgia, serif;
  }
  .built-classic__caption,
  .built-classic__detail {
    margin: 0.2em 0 0;
    font: 500 clamp(13px, 2.65cqmin, 34px)/1.2 system-ui, sans-serif;
  }
  .built-classic__detail { display: none; }
  .screen--lg .built-classic__detail { display: block; }
  .built-classic--horizontal .built-classic__label { align-self: center; }
  .built-classic--quadrant .built-classic__label { padding-block: 0.2rem; }
  .built-classic--quadrant .built-classic__name { font-size: clamp(16px, 4.5cqmin, 44px); }
  .built-classic--quadrant .built-classic__caption { font-size: clamp(11px, 2.3cqmin, 26px); }
  .built-classic__portrait-art { display: none; }
  .screen--portrait .built-classic__landscape-art { display: none; }
  .screen--portrait .built-classic__portrait-art { display: block; }
</style>
{% endcapture %}

{% capture classic_label %}
  <div class="built-classic__meta">{{ selected.location | escape }} · {{ selected.year }}</div>
  <h1 class="built-classic__name">{{ selected.name | escape }}</h1>
  <p class="built-classic__caption">{{ selected.caption | escape }}</p>
{% endcapture %}

{% capture built_title_bar %}
<div class="title_bar built-title-bar">
  <span class="title">BUILT</span>
</div>
{% endcapture %}

{% capture empty_exhibit %}
<div class="layout layout--center">
  <span class="title title--large">Exhibit temporarily unavailable</span>
</div>
{% endcapture %}
